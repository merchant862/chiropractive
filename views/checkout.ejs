                  <script>
                    // 🔹 Helper: get input value safely
                    function formValue(id) {
                      const el = document.getElementById(id);
                      if (!el) return "";
                      if (el.type === "checkbox") return el.checked ? "on" : "off";
                      return el.value.trim();
                    }

                    // 🔹 Phone input enforcement: +1XXXXXXXXXX
                    const phoneInputs = [document.getElementById("billingPhone"), document.getElementById("shippingPhone")];
                    phoneInputs.forEach(input => {
                      if (!input) return;
                      input.setAttribute("maxlength", "12");
                      input.setAttribute("minlength", "12");
                      input.setAttribute("pattern", "^\\+1[0-9]{10}$");
                    });

                    // 🔹 ZIP code enforcement: exactly 5 digits
                    const zipInputs = [document.getElementById("billingPostalCode"), document.getElementById("shippingPostalCode")];
                    zipInputs.forEach(input => {
                      if (!input) return;
                      input.setAttribute("maxlength", "5");
                      input.setAttribute("minlength", "5");
                      input.setAttribute("pattern", "^\\d{5}$");
                    });

                    // 🔹 ZIP code auto-fill with debounce, 5-digit check, max 2 retries
                    function setupZipAutoFill(zipInputId, cityInputId, stateInputId, spinnerId) {
                      const zipInput = document.getElementById(zipInputId);
                      const cityInput = document.getElementById(cityInputId);
                      const stateInput = document.getElementById(stateInputId);
                      const spinner = document.getElementById(spinnerId);

                      if (!zipInput || !cityInput || !stateInput) return;

                      let debounceTimeout;
                      let retryCount = 0;

                      zipInput.addEventListener("input", () => {
                        const zip = zipInput.value.trim();

                        // Reset city/state if zip incomplete
                        if (zip.length !== 5) {
                          cityInput.value = "";
                          stateInput.value = "";
                          retryCount = 0;
                          if (spinner) spinner.style.display = "none";
                          return;
                        }

                        // Debounce: wait 300ms after typing stops
                        clearTimeout(debounceTimeout);
                        debounceTimeout = setTimeout(async () => {
                          if (retryCount >= 2) return;

                          if (spinner) spinner.style.display = "inline-block"; // show spinner

                          try {
                            const res = await fetch(`/api/zip/${zip}`);
                            const data = await res.json();

                            if (res.ok && data?.success && data?.data?.places?.length > 0) {
                              const place = data.data.places[0];
                              cityInput.value = place["place name"] || "";
                              stateInput.value = place["state abbreviation"] || "";
                              retryCount = 0;
                            } else {
                              retryCount++;
                              if (retryCount >= 2) console.warn(`ZIP API failed twice for ${zip}`);
                            }
                          } catch (err) {
                            retryCount++;
                            if (retryCount >= 2) console.warn(`ZIP API error for ${zip}:`, err);
                          } finally {
                            if (spinner) spinner.style.display = "none"; // hide spinner
                          }
                        }, 300);
                      });
                    }


                    // 🔹 Apply to billing & shipping
                    setupZipAutoFill("billingPostalCode", "billingCity", "billingState", "billingZipSpinner");
                    setupZipAutoFill("shippingPostalCode", "shippingCity", "shippingState", "shippingZipSpinner");

                    // 🔹 Submit button and card validation
                    const cardInput = document.getElementById("cardNo");
                    const cvvInput = document.getElementById("cardCVV");
                    const monthSelect = document.getElementById("cardExpMonth");
                    const yearSelect = document.getElementById("cardExpYear");
                    const submitBtn = document.getElementById("placeOrderBtn");
                    const brandIcon = document.getElementById("cardBrandIcon");

                    submitBtn.disabled = true;

                    const CARD_BRANDS = [
                      { name: "visa", regex: /^4/, lengths: [16], cvv: 3 },
                      { name: "mastercard", regex: /^5[1-5]/, lengths: [16], cvv: 3 },
                      { name: "amex", regex: /^3[47]/, lengths: [15], cvv: 4 },
                      { name: "discover", regex: /^6(?:011|5)/, lengths: [16], cvv: 3 },
                      { name: "jcb", regex: /^35/, lengths: [16], cvv: 3 },
                      { name: "unionpay", regex: /^62/, lengths: [16,17,18,19], cvv: 3 },
                      { name: "dc", regex: /^3(?:0|6|8)/, lengths: [14], cvv: 3 },
                    ];

                    function luhnCheck(num) {
                      let sum = 0, shouldDouble = false;
                      for (let i = num.length - 1; i >= 0; i--) {
                        let digit = parseInt(num[i], 10);
                        if (shouldDouble) { digit *= 2; if (digit > 9) digit -= 9; }
                        sum += digit;
                        shouldDouble = !shouldDouble;
                      }
                      return sum % 10 === 0;
                    }

                    function detectCard(number) { return CARD_BRANDS.find(b => b.regex.test(number)); }
                    function markInvalid(el) { el?.classList.add("border-danger"); }
                    function markValid(el) { el?.classList.remove("border-danger"); }

                    function validateForm() {
                      let valid = true;

                      // card number
                      const numberRaw = cardInput.value.replace(/\s/g, "");
                      const brand = detectCard(numberRaw);
                      if (!brand || !brand.lengths.includes(numberRaw.length) || !luhnCheck(numberRaw)) { markInvalid(cardInput); valid=false; }
                      else markValid(cardInput);

                      // cvv
                      if (!brand || cvvInput.value.length !== brand.cvv) { markInvalid(cvvInput); valid=false; }
                      else markValid(cvvInput);

                      // expiry
                      const now = new Date();
                      const expYear = parseInt(yearSelect.value, 10);
                      const expMonth = parseInt(monthSelect.value, 10);
                      if (!expYear || !expMonth || expYear < now.getFullYear() || (expYear === now.getFullYear() && expMonth < now.getMonth()+1)) {
                        markInvalid(monthSelect); markInvalid(yearSelect); valid=false;
                      } else { markValid(monthSelect); markValid(yearSelect); }

                      // billing phone & zip
                      const bp = document.getElementById("billingPhone").value;
                      const bz = document.getElementById("billingPostalCode").value;
                      if (!/^\+1\d{10}$/.test(bp)) { markInvalid(document.getElementById("billingPhone")); valid=false; } else markValid(document.getElementById("billingPhone"));
                      if (!/^\d{5}$/.test(bz)) { markInvalid(document.getElementById("billingPostalCode")); valid=false; } else markValid(document.getElementById("billingPostalCode"));

                      // shipping if checkbox checked
                      if (document.getElementById("c_ship_different_address").checked) {
                        const sp = document.getElementById("shippingPhone").value;
                        const sz = document.getElementById("shippingPostalCode").value;
                        if (!/^\+1\d{10}$/.test(sp)) { markInvalid(document.getElementById("shippingPhone")); valid=false; } else markValid(document.getElementById("shippingPhone"));
                        if (!/^\d{5}$/.test(sz)) { markInvalid(document.getElementById("shippingPostalCode")); valid=false; } else markValid(document.getElementById("shippingPostalCode"));
                      }

                      submitBtn.disabled = !valid;
                    }

                    // input listeners
                    [cardInput, cvvInput, monthSelect, yearSelect, ...phoneInputs, ...zipInputs].forEach(el=>{
                      if(el) el.addEventListener("input", validateForm);
                      if(el?.tagName==="SELECT") el.addEventListener("change", validateForm);
                    });

                    cardInput.addEventListener("input", () => {
                      let value = cardInput.value.replace(/\D/g, "");
                      value = value.match(/.{1,4}/g)?.join(" ") || "";
                      cardInput.value = value;
                      const digits = value.replace(/\s/g, "");

                      const brand = detectCard(digits);

                      if (brand) {
                        brandIcon.src = `/images/${brand.name}.svg`;
                        brandIcon.style.display = "block";
                        brandIcon.style.opacity = "1";
                        cvvInput.maxLength = brand.cvv;
                      } else {
                        // default for empty or invalid input
                        brandIcon.src = "/images/card-default.svg";
                        brandIcon.style.display = "block";
                        brandIcon.style.opacity = "0.6";
                        cvvInput.maxLength = 4;
                      }

                      validateForm();
                    });


                    // 🔹 Submit
                    submitBtn.addEventListener("click", async (e) => {
                      e.preventDefault();
                      if(submitBtn.disabled) return;

                      const payload = {
                        billingFirstName: formValue("billingFirstName"),
                        billingLastName: formValue("billingLastName"),
                        billingCountry: formValue("billingCountry"),
                        billingAddress: formValue("billingAddress"),
                        billingPostalCode: formValue("billingPostalCode"),
                        billingCity: formValue("billingCity"),
                        billingState: formValue("billingState"),
                        billingEmail: formValue("billingEmail"),
                        billingPhone: formValue("billingPhone"),

                        shipToDifferentAddress: formValue("c_ship_different_address"),

                        shippingFirstName: formValue("shippingFirstName"),
                        shippingLastName: formValue("shippingLastName"),
                        shippingCountry: formValue("shippingCountry"),
                        shippingAddress: formValue("shippingAddress"),
                        shippingPostalCode: formValue("shippingPostalCode"),
                        shippingCity: formValue("shippingCity"),
                        shippingState: formValue("shippingState"),
                        shippingEmail: formValue("shippingEmail"),
                        shippingPhone: formValue("shippingPhone"),

                        cardNo: cardInput.value.replace(/\s/g,""),
                        cardExpMonth: monthSelect.value,
                        cardExpYear: yearSelect.value,
                        cardCVV: cvvInput.value
                      };

                      submitBtn.disabled = true;

                      function showCartMessage(boxId, message) {
                        const box = document.getElementById(boxId);
                        if (!box) return;

                        box.textContent = message;
                        box.style.display = "block";   // show
                        box.style.opacity = "1";       // ensure visible

                        setTimeout(() => {
                          box.style.display = "none";  // hide after 3s
                          box.style.opacity = "0";
                        }, 3000);
                      }

                      try {
                        const res = await fetch("/api/checkout", {
                          method: "POST",
                          headers: {"Content-Type":"application/json"},
                          body: JSON.stringify(payload)
                        });

                        const data = await res.json();

                        if(res.ok) {
                          showCartMessage("cart-success-box", data?.message || "Order placed successfully!");
                        } else {
                          showCartMessage("cart-remove-box", data?.error || "Checkout failed. Check your details.");
                        }

                      } catch(err){
                        showCartMessage("cart-remove-box", "Network error. Try again.");
                      } finally {
                        submitBtn.disabled = false;
                      }

                    });
                  </script>

                  
                  <!-- <div class="form-group">
                    <button class="btn btn-primary btn-lg btn-block" onclick="window.location='thankyou.html'">Place
                      Order</button>
                  </div> -->
    
                </div>
              </div>
            </div>
    
          </div>
        </div>
        <!-- </form> -->
      </div>
    </div>
    
    <%- include('partials/footer.ejs') %>

  </div>

<script>
document.addEventListener("DOMContentLoaded", async function () {
  // Hide Returning Customer & Coupon Code sections
  const returningDiv = document.querySelector(".site-section .row.mb-5 .col-md-12 .bg-light");
  const couponDiv = [...document.querySelectorAll(".row.mb-5 .col-md-12")].find(el => 
    el.querySelector("h2")?.textContent.includes("Coupon Code")
  );
  if (returningDiv) returningDiv.style.display = "none";
  if (couponDiv) couponDiv.style.display = "none";

  const orderTableBody = document.querySelector(".site-block-order-table tbody");
  if (!orderTableBody) return;

  // Get cart from localStorage
  const cart = JSON.parse(localStorage.getItem("cart")) || {};
  if (Object.keys(cart).length === 0) {
    orderTableBody.innerHTML = `<tr><td colspan="2">Your cart is empty.</td></tr>`;
    return;
  }

  // Fetch all products from backend
  let products = [];
  try {
    const res = await fetch("/api/products");
    const json = await res.json();
    if (json.success && Array.isArray(json.data)) products = json.data;
  } catch (err) {
    console.error("Failed to fetch products:", err);
  }

  // Map products by slug for easy lookup
  const productMap = {};
  products.forEach(p => productMap[p.slug] = p);

  orderTableBody.innerHTML = "";
  let subtotal = 0;

  // Populate order table
  Object.keys(cart).forEach(key => {
    const item = cart[key];           // cart item
    const product = productMap[key];  // backend product matching slug (cart key)

    const imageSrc = product?.image || "images/product_07_large.png"; // fallback
    const total = item.price * item.qty;
    subtotal += total;

    const tr = document.createElement("tr");
    tr.innerHTML = `
      <td style="display: flex; align-items: center;">
        <img src="${imageSrc}" alt="${item.title}" style="width:50px; height:50px; object-fit:cover; margin-right:10px;">
        ${item.title} <strong class="mx-2">x</strong> ${item.qty}
      </td>
      <td>$${total.toFixed(2)}</td>
    `;
    orderTableBody.appendChild(tr);
  });

  // Subtotal row
  const subtotalRow = document.createElement("tr");
  subtotalRow.innerHTML = `
    <td class="text-black font-weight-bold"><strong>Cart Subtotal</strong></td>
    <td class="text-black">$${subtotal.toFixed(2)}</td>
  `;
  orderTableBody.appendChild(subtotalRow);

  // Total row
  const totalRow = document.createElement("tr");
  totalRow.innerHTML = `
    <td class="text-black font-weight-bold"><strong>Order Total</strong></td>
    <td class="text-black font-weight-bold"><strong>$${subtotal.toFixed(2)}</strong></td>
  `;
  orderTableBody.appendChild(totalRow);
});
</script>


  <%- include('partials/scripts.ejs') %>

</body>

</html>