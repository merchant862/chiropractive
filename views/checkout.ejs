                  <button id="placeOrderBtn" type="button" class="btn btn-primary btn-lg btn-block" disabled>
                    Place Order
                  </button>

                  <script>
                    const cardInput = document.getElementById("cardNo");
                    const cvvInput = document.getElementById("cardCVV");
                    const monthSelect = document.getElementById("cardExpMonth");
                    const yearSelect = document.getElementById("cardExpYear");
                    const submitBtn = document.getElementById("placeOrderBtn");
                    const brandIcon = document.getElementById("cardBrandIcon");

                    submitBtn.disabled = true;

                    const CARD_BRANDS = [
                      { name: "visa", regex: /^4/, lengths: [16], cvv: 3 },
                      { name: "mastercard", regex: /^5[1-5]/, lengths: [16], cvv: 3 },
                      { name: "amex", regex: /^3[47]/, lengths: [15], cvv: 4 },
                      { name: "discover", regex: /^6(?:011|5)/, lengths: [16], cvv: 3 },
                      { name: "jcb", regex: /^35/, lengths: [16], cvv: 3 },
                      { name: "unionpay", regex: /^62/, lengths: [16,17,18,19], cvv: 3 },
                      { name: "dc", regex: /^3(?:0|6|8)/, lengths: [14], cvv: 3 },
                    ];

                    // 🔹 Luhn Algorithm
                    function luhnCheck(num) {
                      let sum = 0;
                      let shouldDouble = false;

                      for (let i = num.length - 1; i >= 0; i--) {
                        let digit = parseInt(num[i], 10);
                        if (shouldDouble) {
                          digit *= 2;
                          if (digit > 9) digit -= 9;
                        }
                        sum += digit;
                        shouldDouble = !shouldDouble;
                      }

                      return sum % 10 === 0;
                    }

                    function detectCard(number) {
                      return CARD_BRANDS.find(b => b.regex.test(number));
                    }

                    function markInvalid(el) {
                      el.classList.add("border-danger");
                    }

                    function markValid(el) {
                      el.classList.remove("border-danger");
                    }

                    function validateForm() {
                      const numberRaw = cardInput.value.replace(/\s/g, "");
                      const brand = detectCard(numberRaw);

                      let valid = true;

                      // Card number validation
                      if (!brand || !brand.lengths.includes(numberRaw.length) || !luhnCheck(numberRaw)) {
                        markInvalid(cardInput);
                        valid = false;
                      } else {
                        markValid(cardInput);
                      }

                      // CVV validation
                      if (!brand || cvvInput.value.length !== brand.cvv) {
                        markInvalid(cvvInput);
                        valid = false;
                      } else {
                        markValid(cvvInput);
                      }

                      // Expiry month/year validation
                      const now = new Date();
                      const currentYear = now.getFullYear();
                      const currentMonth = now.getMonth() + 1;

                      const expYear = parseInt(yearSelect.value, 10);
                      const expMonth = parseInt(monthSelect.value, 10);

                      if (!expYear || !expMonth || expYear < currentYear || (expYear === currentYear && expMonth < currentMonth)) {
                        markInvalid(monthSelect);
                        markInvalid(yearSelect);
                        valid = false;
                      } else {
                        markValid(monthSelect);
                        markValid(yearSelect);
                      }

                      submitBtn.disabled = !valid;
                    }

                    // 🔹 Card number input
                    cardInput.addEventListener("input", () => {
                      // Remove non-digits and format every 4 digits
                      let value = cardInput.value.replace(/\D/g, "");
                      value = value.match(/.{1,4}/g)?.join(" ") || "";
                      cardInput.value = value;

                      const digits = value.replace(/\s/g, "");
                      const brand = detectCard(digits);

                      // Show/hide brand icon inside input
                      if (brand) {
                        brandIcon.src = `/images/${brand.name}.svg`;
                        brandIcon.style.display = "block";
                        cvvInput.maxLength = brand.cvv;
                      } else {
                        brandIcon.style.display = "none";
                        cvvInput.maxLength = 4;
                      }

                      validateForm();
                    });

                    // 🔹 CVV input
                    cvvInput.addEventListener("input", () => {
                      cvvInput.value = cvvInput.value.replace(/\D/g, "");
                      validateForm();
                    });

                    // 🔹 Expiry inputs
                    monthSelect.addEventListener("change", validateForm);
                    yearSelect.addEventListener("change", validateForm);

                    // 🔹 Submit
                    submitBtn.addEventListener("click", () => {
                      if (!submitBtn.disabled) {
                        window.location = "thankyou.html";
                      }
                    });
                  </script>


