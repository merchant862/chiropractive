                      <div class="col-md-12">
                        <label for="cardCVV" class="text-black">
                          CVV <span class="text-danger">*</span>
                        </label>
                        <input
                          type="password"
                          inputmode="numeric"
                          class="form-control"
                          id="cardCVV"
                          name="cardCVV"
                          placeholder="3 or 4 digits"
                          minlength="3"
                          maxlength="4"
                          autocomplete="cc-csc"
                        >
                      </div>
                    </div>
