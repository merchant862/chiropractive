<!DOCTYPE html>
<html lang="en">

<head>
  <title><%= SITE_TITLE %> - <%= PAGE_NAME %></title>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

  <%- include('partials/head.ejs') %>

  <link rel="stylesheet" href="css/custom-css/add-to-cart.css">
  <link rel="stylesheet" href="css/custom-css/remove-from-cart.css">
</head>

<body>

  <%- include('partials/shipping_slider.ejs') %>
  <div id="cart-success-box">Added to cart successfully!</div>
  <div id="cart-remove-box">Removed from cart successfully!</div>

  <div class="site-wrap">

    <%- include('partials/navbar.ejs') %>
    <%- include('partials/mini_navbar.ejs') %>

    <div class="site-section">
      <div class="container">

        <!-- PAGE MAIN HEADING -->
        <!-- <h1 class="text-center mb-5"><%= PRODUCT_DETAILS ? PRODUCT_DETAILS.name : 'Product Page' %></h1> -->

        <% const product = PRODUCT_DETAILS || { 
             title: 'Unknown Product',
             desc: 'Product details not found.',
             newPrice: 0,
             oldPrice: 0,
             image: 'images/product_07_large.png'
        }; %>

        <div class="row">
          <div class="col-md-5 mr-auto">
            <div class="border text-center">
              <img src="<%= product.image %>" alt="Image" class="img-fluid p-5">
            </div>
          </div>

          <div class="col-md-6">
            <!-- PRODUCT NAME -->
            <h2 class="text-black"><%= product.name %></h2>

            <!-- DESCRIPTION -->
            <p><%= product.desc %></p>

            <!-- PRICE -->
             <p style="position:relative;">
  <% if (product.oldPrice && product.oldPrice > product.newPrice) { 
       let discount = Math.round(((product.oldPrice - product.newPrice) / product.oldPrice) * 100);
  %>
    <!-- <del>$<%= product.oldPrice %>.00</del> -->
    <span style="
      font-size:18px;
      color:#dc3545;
      font-weight:600;
      margin-left:6px;
    ">
      (<%= discount %>% Off)
    </span>
  <% } else if(product.oldPrice) { %>
    <del>$<%= product.oldPrice %>.00</del>
  <% } %>

  <strong class="text-primary h4">$<%= product.newPrice %>.00</strong>
</p>

            <!-- <p><del>$<%= product.oldPrice %>.00</del>
              <strong class="text-primary h4">$<%= product.newPrice %>.00</strong>
            </p> -->

            <!-- QUANTITY -->
            <div class="mb-5">
              <div class="input-group mb-3" style="max-width: 220px;">
                <div class="input-group-prepend">
                  <button class="btn btn-outline-primary js-btn-minus" type="button">&minus;</button>
                </div>
                <input type="text" class="form-control text-center js-quantity" value="1" aria-label="Quantity">
                <div class="input-group-append">
                  <button class="btn btn-outline-primary js-btn-plus" type="button">&plus;</button>
                </div>
              </div>
            </div>

            <!-- BUTTONS -->
            <div class="row gx-2">
              <div class="col-sm-4">
                <button class="buy-now btn btn-sm height-auto px-4 py-3 btn-primary">Add To Cart</button>
              </div>
              <div class="col-sm-4">
                <button class="remove-from-cart btn btn-sm height-auto px-4 py-3"
                        style="background: transparent; border: 1px solid #ccc; color: #75b239; border-radius: 0.25rem; display: flex; align-items: center; justify-content: center; transition: all 0.3s;"
                        onmouseover="this.style.color='#fff'; this.style.background='#dc3545'; this.style.border='1px solid #dc3545';"
                        onmouseout="this.style.color='#555'; this.style.background='transparent'; this.style.border='1px solid #ccc';">
                  Remove From Cart
                </button>
              </div>
            </div>

            <!-- TABBED INFO -->
            <div class="mt-5">
              <ul class="nav nav-pills mb-3 custom-pill" id="pills-tab" role="tablist">
                <li class="nav-item">
                  <a class="nav-link active" id="pills-home-tab" data-toggle="pill" href="#pills-home" role="tab"
                    aria-controls="pills-home" aria-selected="true">Ordering Information</a>
                </li>
                <li class="nav-item">
                  <a class="nav-link" id="pills-profile-tab" data-toggle="pill" href="#pills-profile" role="tab"
                    aria-controls="pills-profile" aria-selected="false">Specifications</a>
                </li>
              </ul>

              <div class="tab-content" id="pills-tabContent">
                <div class="tab-pane fade show active" id="pills-home" role="tabpanel" aria-labelledby="pills-home-tab">
                  <table class="table custom-table">
                    <!-- <thead>
                      <th>Material</th>
                      <th>Description</th>
                      <th>Packaging</th>
                    </thead> -->
                    <tr>
                      <th scope="row">Material</th>
                      <td colspan="2"><%= product.material || 'N/A' %></td>
                    </tr>
                    <tr>
                      <th scope="row">Description</th>
                      <td colspan="2"><%= product.moreDesc || product.desc || 'N/A' %></td>
                    </tr>
                    <tr>
                      <th scope="row">Packaging</th>
                      <td colspan="2"><%= product.packaging || 'N/A' %></td>
                    </tr>
                  </table>
                </div>

                <div class="tab-pane fade" id="pills-profile" role="tabpanel" aria-labelledby="pills-profile-tab">
                  <table class="table custom-table">
                    <tbody>
                      <tr>
                        <td>HPIS CODE</td>
                        <td class="bg-light"><%= product.hpisCode || 'N/A' %></td>
                      </tr>

                      <tr>
                        <td>HEALTHCARE PROVIDERS ONLY</td>
                        <td class="bg-light">
                          <%= product.healthCareProvidersOnly === true ? 'Yes' : 'No' %>
                        </td>
                      </tr>

                      <tr>
                        <td>LATEX FREE</td>
                        <td class="bg-light">
                          <%= product.latexFree === true ? 'Yes' : 'No' %>
                        </td>
                      </tr>
                      <tr>
                        <td>MEDICATION ROUTE</td>
                        <td class="bg-light"><%= product.medicationRoute || 'Not Applicable' %></td>
                      </tr>
                    </tbody>

                  </table>
                </div>
              </div>
            </div>

          </div>
        </div>
      </div>
    </div>

    <div class="site-section bg-image overlay" style="background-image: url('images/hero_bg_2.jpg');">
      <div class="container">
        <div class="row justify-content-center text-center">
          <div class="col-lg-7">
            <h3 class="text-white">Exclusive Discounts Available</h3>
            <p class="text-white">
              Get in touch with our support team to learn more about current promotions and special offers on selected products.
            </p>
            <p class="mb-0">
              <a href="mailto:support@pharmative.pk" class="btn btn-outline-white">
                Contact Support
              </a>
            </p>
          </div>
        </div>
      </div>
    </div>


    <!-- <div class="site-section bg-image overlay" style="background-image: url('images/hero_bg_2.jpg');">
      <div class="container">
        <div class="row justify-content-center text-center">
          <div class="col-lg-7">
            <h3 class="text-white">Contact us for discount up to 55% OFF</h3>
            <p class="text-white">Lorem ipsum dolor sit amet consectetur adipisicing elit. Nemo omnis voluptatem consectetur quam.</p>
            <p class="mb-0"><a href="mailto:support@pharmative.pk" class="btn btn-outline-white">Sign up</a></p>
          </div>
        </div>
      </div>
    </div> -->

    <%- include('partials/footer.ejs') %>
  </div>

  <%- include('partials/scripts.ejs') %>

  <script>
    document.addEventListener("DOMContentLoaded", function () {
      const qtyInput = document.querySelector(".js-quantity");
      const btnPlus  = document.querySelector(".js-btn-plus");
      const btnMinus = document.querySelector(".js-btn-minus");
      const btnAdd   = document.querySelector(".buy-now");
      const btnRemove= document.querySelector(".remove-from-cart");

      if (!qtyInput || !btnPlus || !btnMinus || !btnAdd || !btnRemove) return;

      const PRODUCT_ID = "<%= PRODUCT %>";
      const product = { title: "<%= product.name %>", price: <%= product.newPrice %> };

      // Quantity buttons
      btnPlus.addEventListener("click", () => { qtyInput.value = parseInt(qtyInput.value) + 1; });
      btnMinus.addEventListener("click", () => { if (parseInt(qtyInput.value) > 1) qtyInput.value = parseInt(qtyInput.value) - 1; });

      // Add to cart
      btnAdd.addEventListener("click", () => {
        const qty = parseInt(qtyInput.value);
        if (qty <= 0) return;
        let cart = JSON.parse(localStorage.getItem("cart")) || {};
        if (cart[PRODUCT_ID]) cart[PRODUCT_ID].qty += qty;
        else cart[PRODUCT_ID] = { id: PRODUCT_ID, title: product.title, price: product.price, qty: qty };
        localStorage.setItem("cart", JSON.stringify(cart));
        showAlert('success', 'Added to cart successfully');
        setTimeout(() => location.reload(), 2500);
      });

      // Remove from cart
      btnRemove.addEventListener("click", () => {
        let cart = JSON.parse(localStorage.getItem("cart")) || {};
        if (cart[PRODUCT_ID]) {
          delete cart[PRODUCT_ID];
          localStorage.setItem("cart", JSON.stringify(cart));
          showAlert('error', 'Removed from cart successfully');
          setTimeout(() => location.reload(), 2500);
        }
      });

      // Modular alert function
      function showAlert(type, message) {
        const boxId = type === 'success' ? 'cart-success-box' : 'cart-remove-box';
        const box = document.getElementById(boxId);
        if (!box) return;
        box.textContent = message;
        box.style.display = 'block';
        box.style.opacity = 1;
        setTimeout(() => { box.style.opacity = 0; setTimeout(() => box.style.display = 'none', 500); }, 2500);
      }
    });
  </script>

</body>
</html>
