<!DOCTYPE html>
<html lang="en">

<head>
  <title><%= SITE_TITLE %> - <%= PAGE_NAME %></title>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

  <%- include('partials/head.ejs') %>
</head>

<body>

  <%- include('partials/shipping_slider.ejs') %>
  <div class="site-wrap">

    <%- include('partials/navbar.ejs') %>

    <!-- HERO SECTION -->
    <div class="site-blocks-cover overlay" style="background-image: url('images/close-up-patient-doing-physical-therapy.jpg');">
      <div class="container">
        <div class="row">
          <div class="col-lg-12 mx-auto align-self-center">
            <div class="site-block-cover-content text-center">
              <h1 class="mb-0">About <strong class="text-primary">Chiropractive</strong></h1>
              <div class="row justify-content-center mb-5">
                <div class="col-lg-6 text-center">
                  <p>
                    Chiropractive provides high-quality posture and orthopedic support products,
                    helping people reduce daily discomfort through the right product choices
                    and expert guidance over call.
                  </p>
                </div>
              </div>
              <p><a href="/shop/orthopedic-cervical-pillow" class="btn btn-primary px-5 py-3">Shop Products</a></p>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <!-- WHY / WHAT / APPROACH -->
    <div class="site-section py-5" data-aos="fade">
      <div class="container">
        <div class="row">
          <div class="col-lg-4">
            <h3 class="text-black h4">Why Chiropractive</h3>
            <p>
              We focus on practical, everyday solutions for posture and spine support.
              Our products are carefully selected for comfort, durability, and real-world use.
            </p>
          </div>
          <div class="col-lg-4">
            <h3 class="text-black h4">What We Do</h3>
            <p>
              We sell posture and orthopedic support products and help customers choose
              the right option through clear guidance over call — no clinics, no treatments.
            </p>
          </div>
          <div class="col-lg-4">
            <h3 class="text-black h4">Our Approach</h3>
            <p>
              Simple advice, honest recommendations, and products that support better
              posture and mobility in daily life.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- OUR TEAM -->
    <div class="site-section bg-light custom-border-bottom" data-aos="fade">
      <div class="container">
        <div class="row justify-content-center mb-5">
          <div class="title-section text-center col-md-7">
            <h2>Our <strong class="text-primary">Team</strong></h2>
          </div>
        </div>
        <div class="row">
          <div class="col-md-6 col-lg-4 mb-5">
            <div class="block-38 text-center">
              <div class="block-38-img">
                <div class="block-38-header">
                  <img src="images/person_1.jpg" alt="Image placeholder" class="mb-4">
                  <h3 class="block-38-heading h4">Product Specialist</h3>
                  <p class="block-38-subheading">Customer Guidance</p>
                </div>
                <div class="block-38-body">
                  <p>
                    Helps customers understand product usage and select the right support
                    based on daily routine and posture needs.
                  </p>
                </div>
              </div>
            </div>
          </div>

          <div class="col-md-6 col-lg-4 mb-5">
            <div class="block-38 text-center">
              <div class="block-38-img">
                <div class="block-38-header">
                  <img src="images/person_2.jpg" alt="Image placeholder" class="mb-4">
                  <h3 class="block-38-heading h4">Customer Advisor</h3>
                  <p class="block-38-subheading">Product Support</p>
                </div>
                <div class="block-38-body">
                  <p>
                    Guides customers on posture solutions, answers product queries,
                    and ensures a smooth shopping experience.
                  </p>
                </div>
              </div>
            </div>
          </div>

          <div class="col-md-6 col-lg-4 mb-5">
            <div class="block-38 text-center">
              <div class="block-38-img">
                <div class="block-38-header">
                  <img src="images/person_3.jpg" alt="Image placeholder" class="mb-4">
                  <h3 class="block-38-heading h4">Operations Manager</h3>
                  <p class="block-38-subheading">Logistics & Delivery</p>
                </div>
                <div class="block-38-body">
                  <p>
                    Ensures products reach customers on time and handles return/exchange processes efficiently.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- DISCOUNT CTA -->
    <div class="site-section bg-image overlay" style="background-image: url('images/hero_bg_2.jpg');">
      <div class="container">
        <div class="row justify-content-center text-center">
          <div class="col-lg-7">
            <h3 class="text-white">Get Exclusive Discounts & Offers</h3>
            <p class="text-white">
              Sign up to receive updates on new products, special deals,
              and posture support tips.
            </p>
            <p class="mb-0"><a href="/shop/orthopedic-cervical-pillow" class="btn btn-outline-white">Explore Products</a></p>
          </div>
        </div>
      </div>
    </div>

    <!-- FEATURES -->
    <div class="site-section site-section-sm site-blocks-1 border-0" data-aos="fade">
      <div class="container">
        <div class="row">
          <div class="col-md-6 col-lg-4 d-lg-flex mb-4 mb-lg-0 pl-4" data-aos="fade-up">
            <div class="icon mr-4 align-self-start">
              <span class="icon-truck text-primary"></span>
            </div>
            <div class="text">
              <h2>Free Shipping</h2>
              <p>
                Fast and reliable delivery on all posture and orthopedic support products.
              </p>
            </div>
          </div>

          <div class="col-md-6 col-lg-4 d-lg-flex mb-4 mb-lg-0 pl-4" data-aos="fade-up" data-aos-delay="100">
            <div class="icon mr-4 align-self-start">
              <span class="icon-refresh2 text-primary"></span>
            </div>
            <div class="text">
              <h2>Easy Returns</h2>
              <p>
                Hassle-free returns for unused products within our return policy.
              </p>
            </div>
          </div>

          <div class="col-md-6 col-lg-4 d-lg-flex mb-4 mb-lg-0 pl-4" data-aos="fade-up" data-aos-delay="200">
            <div class="icon mr-4 align-self-start">
              <span class="icon-help text-primary"></span>
            </div>
            <div class="text">
              <h2>Customer Support</h2>
              <p>
                Friendly support team available to guide you before and after purchase.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- FOOTER -->
    <%- include('partials/footer.ejs') %>

  </div>

  <%- include('partials/scripts.ejs') %>

</body>

</html>
