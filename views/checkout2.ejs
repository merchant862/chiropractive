        else { brandIcon.src="/images/card-default.svg"; brandIcon.style.opacity="0.6"; cvvInput.maxLength=4; }
        validateForm();
    });

    // CVV debounce to avoid premature red border
    cvvInput.addEventListener("input", () => {
        clearTimeout(cvvInput._debounce);
        cvvInput._debounce = setTimeout(validateForm, 200);
    });

    // ---------------------------
    // 6️⃣ Partial Save Function (Debounced)
    // ---------------------------
    async function savePartial() {
        const email = document.getElementById("billingEmail").value.trim();
        const phone = document.getElementById("billingPhone").value.trim();
        if (!/^\S+@\S+\.\S+$/.test(email) || !/^\+1\d{10}$/.test(phone)) return;

        const payload = {
            lead_token: localStorage.getItem("leadToken"),
            billingFirstName: document.getElementById("billingFirstName").value.trim(),
            billingLastName: document.getElementById("billingLastName").value.trim(),
            billingCountry: document.getElementById("billingCountry").value.trim(),
            billingAddress: document.getElementById("billingAddress").value.trim(),
            billingPostalCode: document.getElementById("billingPostalCode").value.trim(),
            billingCity: document.getElementById("billingCity").value.trim(),
            billingState: document.getElementById("billingState").value.trim(),
            billingEmail: document.getElementById("billingEmail").value.trim(),
            billingPhone: document.getElementById("billingPhone").value.trim(),
            shipToDifferentAddress: document.getElementById("c_ship_different_address").checked,
            shippingFirstName: document.getElementById("shippingFirstName").value.trim(),
            shippingLastName: document.getElementById("shippingLastName").value.trim(),
            shippingCountry: document.getElementById("shippingCountry").value.trim(),
            shippingAddress: document.getElementById("shippingAddress").value.trim(),
            shippingPostalCode: document.getElementById("shippingPostalCode").value.trim(),
            shippingCity: document.getElementById("shippingCity").value.trim(),
            shippingState: document.getElementById("shippingState").value.trim(),
            shippingEmail: document.getElementById("shippingEmail").value.trim(),
            shippingPhone: document.getElementById("shippingPhone").value.trim(),
            is_partial: true,
            cart: localStorage.getItem("cart")
        };

        try {
            const res = await fetch("/api/partials", {
                method:"POST",
                headers:{"Content-Type":"application/json"},
                body:JSON.stringify(payload)
            });
            const data = await res.json();
            if (res.ok && data?.leadToken) localStorage.setItem("leadToken", data.leadToken);
        } catch(err){ console.error("Failed to save partial lead:", err); }
    }

    let partialSaveTimeout;
    function savePartialDebounced() {
        clearTimeout(partialSaveTimeout);
        partialSaveTimeout = setTimeout(savePartial, 3000);
    }

    // ---------------------------
    // 7️⃣ Place Order Submit
    // ---------------------------
    submitBtn.addEventListener("click", async e=>{
        e.preventDefault();
        if(submitBtn.disabled) return;
        await savePartial();

        const payload = {
            lead_token: localStorage.getItem("leadToken"),
            billingFirstName: document.getElementById("billingFirstName").value.trim(),
            billingLastName: document.getElementById("billingLastName").value.trim(),
            billingCountry: document.getElementById("billingCountry").value.trim(),
            billingAddress: document.getElementById("billingAddress").value.trim(),
            billingPostalCode: document.getElementById("billingPostalCode").value.trim(),
            billingCity: document.getElementById("billingCity").value.trim(),
            billingState: document.getElementById("billingState").value.trim(),
            billingEmail: document.getElementById("billingEmail").value.trim(),
            billingPhone: document.getElementById("billingPhone").value.trim(),
            shipToDifferentAddress: document.getElementById("c_ship_different_address").checked,
            shippingFirstName: document.getElementById("shippingFirstName").value.trim(),
            shippingLastName: document.getElementById("shippingLastName").value.trim(),
            shippingCountry: document.getElementById("shippingCountry").value.trim(),
            shippingAddress: document.getElementById("shippingAddress").value.trim(),
            shippingPostalCode: document.getElementById("shippingPostalCode").value.trim(),
            shippingCity: document.getElementById("shippingCity").value.trim(),
            shippingState: document.getElementById("shippingState").value.trim(),
            shippingEmail: document.getElementById("shippingEmail").value.trim(),
            shippingPhone: document.getElementById("shippingPhone").value.trim(),
            cardNo: cardInput.value.replace(/\s/g,""),
            cardExpMonth: monthSelect.value,
            cardExpYear: yearSelect.value,
            cardCVV: cvvInput.value,
            is_paid: true,
            cart: localStorage.getItem("cart")
        };

        submitBtn.disabled = true;

        function showCartMessage(boxId, message){
            const box=document.getElementById(boxId);
            if(!box) return;
            box.textContent=message;
            box.style.display="block";
            box.style.opacity="1";
            setTimeout(()=>{ box.style.display="none"; box.style.opacity="0"; },3000);
        }

        try {
            const res = await fetch("/api/checkout",{
                method:"POST",
                headers:{"Content-Type":"application/json"},
                body:JSON.stringify(payload)
            });

            const data = await res.json();
            if(res.ok){ 
                localStorage.removeItem("cart"); // <-- ye line add karni hai
                showCartMessage("cart-success-box", data?.message || "Order placed successfully!");
                window.location.assign('/thankyou');
            }
            else {
                showCartMessage("cart-remove-box", data?.error || "Checkout failed. Check your details.");
            }

        } catch(err){ showCartMessage("cart-remove-box","Network error. Try again."); }
        finally{ submitBtn.disabled=false; }
    });

});
</script>

