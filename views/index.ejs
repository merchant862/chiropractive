<!DOCTYPE html>
<html lang="en">

<head>
  <title><%= SITE_TITLE %> - <%= PAGE_NAME %></title>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

  <%- include('partials/head.ejs') %>
</head>

<body>

<div class="site-wrap">

  <%- include('partials/navbar.ejs') %>

  <!-- HERO SLIDER -->
  <div class="owl-carousel owl-single px-0">

    <div class="site-blocks-cover overlay" style="background-image: url('images/pilates-class-equipment-bench.jpg');">
      <div class="container">
        <div class="row">
          <div class="col-lg-12 mx-auto align-self-center">
            <div class="site-block-cover-content text-center">
              <h1 class="mb-0">
                Smart <strong class="text-primary">Spine & Posture Support</strong>
              </h1>

              <div class="row justify-content-center mb-5">
                <div class="col-lg-7 text-center">
                  <p>
                    Carefully selected posture and spine support products to help reduce daily discomfort,
                    improve alignment, and support a healthier lifestyle.
                  </p>
                </div>
              </div>

              <p>
                <a href="#products-wrap" class="btn btn-primary px-5 py-3">
                  View Support Products
                </a>
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="site-blocks-cover overlay" style="background-image: url('images/medium-shot-physiotherapist-helping-patient.jpg');">
      <div class="container">
        <div class="row">
          <div class="col-lg-12 mx-auto align-self-center">
            <div class="site-block-cover-content text-center">
              <h1 class="mb-0">
                Get Guidance Before You Buy
              </h1>
              <div class="row justify-content-center mb-5">
                <div class="col-lg-7 text-center">
                  <p>
                    Not sure which product is right for you?  
                    Call us for basic posture and product guidance to help you make an informed choice.
                  </p>
                </div>
              </div>
              <p>
                <a href="mailto:support@pharmative.pk" class="btn btn-primary px-5 py-3">
                  Talk to Us
                </a>
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>

  </div>

  <!-- FEATURES -->
  <div class="site-section py-5">
    <div class="container">
      <div class="row">

        <div class="col-lg-4">
          <div class="feature">
            <span class="wrap-icon flaticon-24-hours-drugs-delivery"></span>
            <h3><a href="#">Posture Support Products</a></h3>
            <p>
              Products designed to support the neck, back, and spine during daily activities and rest.
            </p>
          </div>
        </div>

        <div class="col-lg-4">
          <div class="feature">
            <span class="wrap-icon flaticon-medicine"></span>
            <h3><a href="#">Non-Medical Guidance</a></h3>
            <p>
              We provide product-related guidance only and do not offer medical diagnosis or treatment.
            </p>
          </div>
        </div>

        <div class="col-lg-4">
          <div class="feature">
            <span class="wrap-icon flaticon-test-tubes"></span>
            <h3><a href="#">Everyday Spine Care</a></h3>
            <p>
              Support your posture at work, during travel, and while resting with the right tools.
            </p>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- PRODUCTS -->
  <div class="site-section bg-light">
    <div class="container">
      <div class="row">
        <div class="title-section text-center col-12">
          <h2>Posture & <strong class="text-primary">Spine Support Products</strong></h2>
        </div>
      </div>

      <div class="row">
        <div class="col-md-12 block-3 products-wrap" id="products-wrap">
          <div class="nonloop-block-3 owl-carousel">

            <% if (PRODUCTS && PRODUCTS.length > 0) { %>
              <% PRODUCTS.forEach(product => { %>

                <div class="text-center item mb-4 item-v2">
                  <a href="/shop/<%= product.slug %>">
                    <img src="<%= product.image %>" alt="<%= product.name %>">
                  </a>

                  <h3 class="text-dark">
                    <a href="/shop/<%= product.slug %>"><%= product.name %></a>
                  </h3>

                  <p class="price">
                    <% if (product.oldPrice) { %>
                      <del>$<%= product.oldPrice %></del>
                    <% } %>
                    <span>$<%= product.newPrice %></span>
                  </p>
                </div>

              <% }) %>
            <% } else { %>
              <p class="text-center">Products coming soon</p>
            <% } %>

          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- CTA -->
  <div class="site-section bg-image overlay" style="background-image: url('images/hero_bg_2.jpg');">
    <div class="container">
      <div class="row justify-content-center text-center">
        <div class="col-lg-7">
          <h3 class="text-white">
            Need Help Choosing the Right Product?
          </h3>
          <p class="text-white">
            Call us for basic guidance on posture support products before making a purchase.
          </p>
          <p class="mb-0">
            <a href="mailto:support@pharmative.pk" class="btn btn-outline-white">
              Get Product Guidance
            </a>
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- TRUST + WHY US -->
  <div class="site-section">
    <div class="container">

      <div class="row justify-content-between">
        <div class="col-lg-6">
          <div class="title-section">
            <h2>Customer <strong class="text-primary">Feedback</strong></h2>
          </div>

          <div class="block-3 products-wrap">
            <div class="owl-single no-direction owl-carousel">

              <div class="testimony">
                <blockquote>
                  <p>
                    &ldquo;The guidance helped me choose the right pillow for my neck pain.
                    The product quality is excellent.&rdquo;
                  </p>
                </blockquote>
                <p class="author">&mdash; Verified Customer</p>
              </div>

              <div class="testimony">
                <blockquote>
                  <p>
                    &ldquo;Good quality posture support products and honest guidance without pressure.&rdquo;
                  </p>
                </blockquote>
                <p class="author">&mdash; Verified Customer</p>
              </div>

            </div>
          </div>
        </div>

        <div class="col-lg-5">
          <div class="title-section">
            <h2 class="mb-5">Why <strong class="text-primary">Choose Us</strong></h2>

            <div class="step-number d-flex mb-4">
              <span>1</span>
              <p>Carefully selected posture and spine support products</p>
            </div>

            <div class="step-number d-flex mb-4">
              <span>2</span>
              <p>Clear and honest product guidance over call</p>
            </div>

            <div class="step-number d-flex mb-4">
              <span>3</span>
              <p>No medical claims, no false promises — just support tools</p>
            </div>

          </div>
        </div>

      </div>
    </div>
  </div>

  <%- include('partials/footer.ejs') %>

</div>

<%- include('partials/scripts.ejs') %>

</body>
</html>
