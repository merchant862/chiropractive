<!DOCTYPE html>
<html lang="en">

<head>
  <title><%= SITE_TITLE %> - <%= PAGE_NAME %></title>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

  <%- include('partials/head.ejs') %>
</head>

<body>

<div class="site-wrap">

  <%- include('partials/navbar.ejs') %>

  <!-- HERO SLIDER -->
  <div class="owl-carousel owl-single px-0">

    <div class="site-blocks-cover overlay" style="background-image: url('images/hero_bg.jpg');">
      <div class="container">
        <div class="row">
          <div class="col-lg-12 mx-auto align-self-center">
            <div class="site-block-cover-content text-center">
              <h1 class="mb-0">
                Professional <strong class="text-primary">Chiropractic Care</strong>
              </h1>

              <div class="row justify-content-center mb-5">
                <div class="col-lg-6 text-center">
                  <p>
                    Natural and effective treatment for back pain, neck pain, posture correction, and spinal alignment.
                  </p>
                </div>
              </div>

              <p>
                <a href="/contact" class="btn btn-primary px-5 py-3">Book Appointment</a>
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="site-blocks-cover overlay" style="background-image: url('images/hero_bg_2.jpg');">
      <div class="container">
        <div class="row">
          <div class="col-lg-12 mx-auto align-self-center">
            <div class="site-block-cover-content text-center">
              <h1 class="mb-0">
                Support Your <strong class="text-primary">Spine & Posture</strong>
              </h1>
              <div class="row justify-content-center mb-5">
                <div class="col-lg-6 text-center">
                  <p>
                    Explore chiropractic support products designed to improve posture and reduce daily discomfort.
                  </p>
                </div>
              </div>
              <p>
                <a href="/shop" class="btn btn-primary px-5 py-3">View Products</a>
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>

  </div>

  <!-- FEATURES -->
  <div class="site-section py-5">
    <div class="container">
      <div class="row">

        <div class="col-lg-4">
          <div class="feature">
            <span class="wrap-icon flaticon-24-hours-drugs-delivery"></span>
            <h3><a href="#">Experienced Chiropractors</a></h3>
            <p>
              Qualified professionals providing safe and effective spinal adjustments.
            </p>
          </div>
        </div>

        <div class="col-lg-4">
          <div class="feature">
            <span class="wrap-icon flaticon-medicine"></span>
            <h3><a href="#">Drug-Free Treatment</a></h3>
            <p>
              Natural pain relief without medication or invasive procedures.
            </p>
          </div>
        </div>

        <div class="col-lg-4">
          <div class="feature">
            <span class="wrap-icon flaticon-test-tubes"></span>
            <h3><a href="#">Posture & Spine Care</a></h3>
            <p>
              Long-term solutions for posture correction and spinal health.
            </p>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- PRODUCTS -->
  <div class="site-section bg-light">
    <div class="container">
      <div class="row">
        <div class="title-section text-center col-12">
          <h2>Chiropractic <strong class="text-primary">Support Products</strong></h2>
        </div>
      </div>

      <div class="row">
        <div class="col-md-12 block-3 products-wrap">
          <div class="nonloop-block-3 owl-carousel">

            <div class="text-center item mb-4 item-v2">
              <span class="onsale">Popular</span>
              <a href="shop-single.html">
                <img src="images/product_03.png" alt="Image">
              </a>
              <h3 class="text-dark">
                <a href="shop-single.html">Orthopedic Cervical Pillow</a>
              </h3>
              <p class="price">$120.00</p>
            </div>

            <div class="text-center item mb-4 item-v2">
              <a href="shop-single.html">
                <img src="images/product_01.png" alt="Image">
              </a>
              <h3 class="text-dark">
                <a href="shop-single.html">Posture Corrector Belt</a>
              </h3>
              <p class="price">$120.00</p>
            </div>

            <div class="text-center item mb-4 item-v2">
              <span class="onsale">Recommended</span>
              <a href="shop-single.html">
                <img src="images/product_02.png" alt="Image">
              </a>
              <h3 class="text-dark">
                <a href="shop-single.html">Lumbar Support Cushion</a>
              </h3>
              <p class="price">$120.00</p>
            </div>

            <div class="text-center item mb-4 item-v2">
              <a href="shop-single.html">
                <img src="images/product_04.png" alt="Image">
              </a>
              <h3 class="text-dark">
                <a href="shop-single.html">Therapy Massage Tool</a>
              </h3>
              <p class="price">$120.00</p>
            </div>

          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- CTA -->
  <div class="site-section bg-image overlay" style="background-image: url('images/hero_bg_2.jpg');">
    <div class="container">
      <div class="row justify-content-center text-center">
        <div class="col-lg-7">
          <h3 class="text-white">
            Start Your Journey to a Pain-Free Life
          </h3>
          <p class="text-white">
            Book a chiropractic consultation and take the first step toward better mobility and posture.
          </p>
          <p class="mb-0">
            <a href="/contact" class="btn btn-outline-white">Book Consultation</a>
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- TESTIMONIALS + WHY US -->
  <div class="site-section">
    <div class="container">

      <div class="row justify-content-between">
        <div class="col-lg-6">
          <div class="title-section">
            <h2>Happy <strong class="text-primary">Patients</strong></h2>
          </div>

          <div class="block-3 products-wrap">
            <div class="owl-single no-direction owl-carousel">

              <div class="testimony">
                <blockquote>
                  <p>
                    &ldquo;My back pain reduced significantly after just a few chiropractic sessions.&rdquo;
                  </p>
                </blockquote>
                <p class="author">&mdash; Patient Review</p>
              </div>

              <div class="testimony">
                <blockquote>
                  <p>
                    &ldquo;Excellent care and guidance for posture correction and spinal health.&rdquo;
                  </p>
                </blockquote>
                <p class="author">&mdash; Patient Review</p>
              </div>

            </div>
          </div>
        </div>

        <div class="col-lg-5">
          <div class="title-section">
            <h2 class="mb-5">Why <strong class="text-primary">Choose Us</strong></h2>

            <div class="step-number d-flex mb-4">
              <span>1</span>
              <p>Detailed spine and posture assessment</p>
            </div>

            <div class="step-number d-flex mb-4">
              <span>2</span>
              <p>Personalized chiropractic treatment plan</p>
            </div>

            <div class="step-number d-flex mb-4">
              <span>3</span>
              <p>Ongoing care and recovery support</p>
            </div>

          </div>
        </div>

      </div>
    </div>
  </div>

  <%- include('partials/footer.ejs') %>

</div>

<%- include('partials/scripts.ejs') %>

</body>
</html>
