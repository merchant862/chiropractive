  // Function to show popup
  function showPopup(popupId, textId, starsId, text, stars, duration){
    const popup = document.getElementById(popupId);

    // Hide other popup on mobile to prevent overlap
    const reviewPopup = document.getElementById("review-popup");
    const purchasePopup = document.getElementById("live-popup");
    const mobile = window.innerWidth <= 768;
    if(mobile){
      if(popupId === "live-popup") reviewPopup.style.display = "none";
      if(popupId === "review-popup") purchasePopup.style.display = "none";
    }

    // Set text
    document.getElementById(textId).innerText = text;
    if(starsId) document.getElementById(starsId).innerText = stars || "";

    // Show popup with transition
    popup.style.display = "block";
    setTimeout(()=>{ popup.style.opacity=1; popup.style.transform="translateY(0)"; }, 50);

