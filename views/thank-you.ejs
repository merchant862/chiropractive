<!DOCTYPE html>
<html lang="en">

<head>
  <title><%= SITE_TITLE %> - <%= PAGE_NAME %></title>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

  <%- include('partials/head.ejs') %>

  <style>
    /* MOBILE */
    @media only screen and (max-width:600px){
      .container{width:100%!important;padding:15px;}
    }

    .center-block {
      display: flex;
      justify-content: center;
      align-items: center;
      flex-direction: column;
      text-align: center;
    }
  </style>
</head>

<body>

  <%- include('partials/shipping_slider.ejs') %>

  <div class="site-wrap">
    
    <%- include('partials/navbar.ejs') %>

    <%- include('partials/mini_navbar.ejs') %>

    <div class="site-section">
      <div class="container">

        <!-- SUCCESS MESSAGE CENTERED -->
        <div class="row justify-content-center">
          <div class="col-lg-6 center-block">

            <span class="icon-check_circle display-3" style="color:#75b239;"></span>

            <h2 class="display-4 text-black mt-3">
              Thank You For Your Order!
            </h2>

            <p class="lead mt-3" style="color:#666;">
              Your order has been successfully placed. <br>
              Our team is now preparing it for shipment. <br>
              You will receive a confirmation email shortly.
            </p>

            <!-- NEXT STEPS / TRUST -->
            <div style="padding:25px; border:1px solid #eee; border-radius:8px; background:#f8f9fa; margin-top:20px;">
              <h5 style="font-weight:600;">What Happens Next?</h5>
              <ul style="list-style:none;padding-left:0;font-size:14px;color:#555;margin-top:15px;">
                <li style="margin-bottom:8px;">✔ Order confirmation email within 2-3 hours</li>
                <li style="margin-bottom:8px;">✔ Fast & Free US Shipping</li>
                <li style="margin-bottom:8px;">✔ Tracking details shared via Email</li>
                <li>✔ 30-Day Risk-Free Money Back Guarantee</li>
              </ul>
            </div>

            <!-- CTA BUTTON -->
            <a href="/" class="btn btn-md height-auto px-5 py-3 btn-primary mt-4">
              Continue Shopping
            </a>

          </div>
        </div>

      </div>
    </div>

    <%- include('partials/footer.ejs') %>
  </div>

  <%- include('partials/scripts.ejs') %>

  <script>
    document.addEventListener("DOMContentLoaded", function(){
      // Optional: Clear cart after showing
      localStorage.removeItem("cart");
    });
  </script>

</body>
</html>
