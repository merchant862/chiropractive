<!DOCTYPE html>
<html lang="en">

<head>
  <title><%= SITE_TITLE %> - <%= PAGE_NAME %></title>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  
  <%- include('partials/head.ejs') %>

  <link rel="stylesheet" href="css/custom-css/add-to-cart.css">
  <link rel="stylesheet" href="css/custom-css/remove-from-cart.css">
</head>

<body>

  <div class="site-wrap">

    <%- include('partials/navbar.ejs') %>
    <%- include('partials/mini_navbar.ejs') %>

    <!-- Success / Remove Alerts -->
    <div id="cart-success-box" class="cart-alert success"></div>
    <div id="cart-remove-box" class="cart-alert remove"></div>

    <div class="site-section">
      <div class="container">
        <div class="row mb-5">
          <div class="col-md-12">
            <div class="site-blocks-table">
              <table class="table table-bordered">
                <thead>
                  <tr>
                    <th class="product-thumbnail">Image</th>
                    <th class="product-name">Product</th>
                    <th class="product-price">Price</th>
                    <th class="product-quantity">Quantity</th>
                    <th class="product-total">Total</th>
                    <th class="product-remove">Remove</th>
                  </tr>
                </thead>
                <tbody id="cart-body">
                  <!-- JS will render rows here -->
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <div class="row mb-5">
          <div class="col-md-6">
            <div class="row mb-3">
              <div class="col-md-6 mb-3 mb-md-0">
                <button class="btn btn-primary btn-md btn-block" id="update-cart">Update Cart</button>
              </div>
              <div class="col-md-6">
                <button class="btn btn-outline-primary btn-md btn-block" onclick="window.location='/'">Continue Shopping</button>
              </div>
            </div>
          </div>
        </div>

        <div class="row justify-content-end">
          <div class="col-md-6">
            <h3 class="text-black h4 text-uppercase border-bottom pb-3 mb-3">Cart Totals</h3>
            <div class="d-flex justify-content-between mb-2">
              <span>Subtotal</span>
              <strong id="cart-subtotal">$0.00</strong>
            </div>
            <div class="d-flex justify-content-between mb-3">
              <span>Total</span>
              <strong id="cart-total">$0.00</strong>
            </div>
            <button class="btn btn-primary btn-lg btn-block" onclick="window.location='checkout.html'">Proceed To Checkout</button>
          </div>
        </div>
      </div>
    </div>

    <%- include('partials/footer.ejs') %>
  </div>

  <%- include('partials/scripts.ejs') %>

  <script>
    document.addEventListener("DOMContentLoaded", function() {

      const cartBody = document.getElementById("cart-body");
      const subtotalEl = document.getElementById("cart-subtotal");
      const totalEl = document.getElementById("cart-total");

      // Modular alert function
      function showAlert(boxId, message) {
        const box = document.getElementById(boxId);
        if (!box) return;
        box.textContent = message;
        box.classList.add("show");
        setTimeout(() => box.classList.remove("show"), 2500);
      }

      // Render cart items from localStorage
      function renderCart() {
        const cart = JSON.parse(localStorage.getItem("cart")) || {};
        cartBody.innerHTML = "";
        let subtotal = 0;

        Object.keys(cart).forEach(id => {
          const item = cart[id];
          const row = document.createElement("tr");

          row.innerHTML = `
            <td class="product-thumbnail"><img src="images/product_07_large.png" alt="Image" class="img-fluid"></td>
            <td class="product-name"><h2 class="h5 text-black">${item.title}</h2></td>
            <td>$${item.price.toFixed(2)}</td>
            <td>
              <div class="input-group mb-3" style="max-width: 120px;">
                <div class="input-group-prepend">
                  <button class="btn btn-outline-primary js-btn-minus" type="button">&minus;</button>
                </div>
                <input type="text" class="form-control text-center js-quantity" value="${item.qty}" />
                <div class="input-group-append">
                  <button class="btn btn-outline-primary js-btn-plus" type="button">&plus;</button>
                </div>
              </div>
            </td>
            <td>$${(item.price * item.qty).toFixed(2)}</td>
            <td>
              <button class="btn btn-sm btn-outline-danger js-remove">X</button>
            </td>
          `;

          cartBody.appendChild(row);

          subtotal += item.price * item.qty;
        });

        subtotalEl.textContent = `$${subtotal.toFixed(2)}`;
        totalEl.textContent = `$${subtotal.toFixed(2)}`;

        attachRowEvents();
      }

      // Attach +, -, remove events
      function attachRowEvents() {
        const rows = cartBody.querySelectorAll("tr");

        rows.forEach(row => {
          const minus = row.querySelector(".js-btn-minus");
          const plus = row.querySelector(".js-btn-plus");
          const qtyInput = row.querySelector(".js-quantity");
          const removeBtn = row.querySelector(".js-remove");

          const title = row.querySelector(".product-name h2").innerText;
          const cart = JSON.parse(localStorage.getItem("cart")) || {};
          const id = Object.keys(cart).find(k => cart[k].title === title);

          minus.addEventListener("click", () => {
            let val = parseInt(qtyInput.value);
            if (val > 1) qtyInput.value = val - 1;
          });

          plus.addEventListener("click", () => {
            qtyInput.value = parseInt(qtyInput.value) + 1;
          });

          removeBtn.addEventListener("click", () => {
            if (!id) return;
            delete cart[id];
            localStorage.setItem("cart", JSON.stringify(cart));
            showAlert("cart-remove-box", "Removed from cart successfully!");
            renderCart();
          });
        });
      }

      // Update cart button
      const updateBtn = document.getElementById("update-cart");
      updateBtn.addEventListener("click", (e) => {
        e.preventDefault();
        const cart = JSON.parse(localStorage.getItem("cart")) || {};

        cartBody.querySelectorAll("tr").forEach(row => {
          const title = row.querySelector(".product-name h2").innerText;
          const qty = parseInt(row.querySelector(".js-quantity").value);
          const id = Object.keys(cart).find(k => cart[k].title === title);
          if (id && cart[id]) {
            cart[id].qty = qty < 1 ? 1 : qty;
          }
        });

        localStorage.setItem("cart", JSON.stringify(cart));
        showAlert("cart-success-box", "Cart updated successfully!");
        renderCart();
      });

      // Initial render
      renderCart();

    });
  </script>

</body>
</html>
